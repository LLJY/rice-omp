{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "workflow": {
      "type": "stdio",
      "command": "${HOME}/.omp/agent/mcp/workflow/run.sh"
    },
    "researcher-mcp": {
      "type": "stdio",
      "command": "${HOME}/.omp/agent/mcp/researcher-mcp/run.sh",
      "env": {
        "SCHOLAR_CONTACT_EMAIL": "!printf %s \"$SCHOLAR_CONTACT_EMAIL\""
      },
      "timeout": 120000
    },
    "hound": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--from", "hound-mcp[all]==12.4.1", "hound"],
      "timeout": 120000
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "!printf %s \"$CONTEXT7_API_KEY\""
      }
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    }
  }
}
